# Guduu DI Web UI — 源码部署环境变量
# 复制: cp .env.local.example .env.local
#
# 以下变量名沿用历史兼容命名，分别指向语义引擎、AI 服务与 ibis-server

WREN_ENGINE_ENDPOINT=http://127.0.0.1:8080
WREN_AI_ENDPOINT=http://127.0.0.1:5555
IBIS_SERVER_ENDPOINT=http://127.0.0.1:8000

OTHER_SERVICE_USING_DOCKER=false
EXPERIMENTAL_ENGINE_RUST_VERSION=false
TELEMETRY_ENABLED=false

DB_TYPE=sqlite
SQLITE_FILE=./db.sqlite3

GENERATION_MODEL=gpt-4o-mini
